# ==============================================================================
# WearID — Environment Variables
# Copy this file to .env.local for local development, and add these to Vercel
# ==============================================================================

# 1. Supabase Cloud Configuration (Project Ref: tbzpzuxhlykwzcspoewf)
# Get these keys from: https://supabase.com/dashboard/project/tbzpzuxhlykwzcspoewf/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tbzpzuxhlykwzcspoewf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. Local Fallback Flag (optional)
# Set to "false" when using live Supabase; set to "true" to use zero-dependency in-memory mock client
NEXT_PUBLIC_USE_LOCAL_MOCKS=false

# 3. Cryptographic Security & Sizing Tokens (Invariant 7)
# Must be a secure random string of at least 32 characters
JWT_SECRET=wearid_production_token_signing_secret_key_32_characters_minimum_random!
JWT_EXPIRES_IN=24h

# 4. Biometric Encryption & Sovereign Salt
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SOVEREIGN_PASSPORT_SALT=wearid_salt_sovereign_identity_deterministic_master

# 5. Retailer Integration & Webhook Dispatch (Phase 4)
WEARID_WEBHOOK_SECRET=wearid_webhook_hmac_signing_secret_key_32_chars_min!
RETAILER_SANDBOX_API_KEY=wearid_sandbox_partner_key_test_123

# 6. Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
